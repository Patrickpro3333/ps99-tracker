// Cloudflare Worker settings. Cloudflare builds and deploys this on every push to main.
// The site's files are served as static assets (free, unlimited); .assetsignore keeps the
// scripts and docs out. Code runs only for the proxies and the hourly Cron Trigger.
{
  "name": "ps99-tracker",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/ps99api/*", "/rbx/*", "/rbxt/*"]
  },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
